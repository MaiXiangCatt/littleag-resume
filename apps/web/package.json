    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.16",
    "@react-pdf/renderer": "^4.5.1",
