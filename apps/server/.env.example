SERVER_ADDR=:8080
DATABASE_URL=postgres://vega_resume:vega_resume@localhost:5432/vega_resume?sslmode=disable
AVATAR_STORAGE_DIR=data/avatars
# 仅信任这些反向代理传入的 X-Forwarded-For / X-Real-IP；逗号分隔 IP 或 CIDR
TRUSTED_PROXIES=127.0.0.1,::1
# Generate a local key with: openssl rand -hex 32
ACCESS_TOKEN_KEY=example_access_token_key_at_least_32_bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ACCOUNT_LOCK_LIMIT=5
ACCOUNT_LOCK_TTL=15m

# 邮箱验证码
# 独立生成：openssl rand -hex 32
EMAIL_VERIFICATION_KEY=example_email_verification_key_at_least_32_bytes
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_ATTEMPT_LIMIT=5
EMAIL_RESEND_COOLDOWN=60s
# 本地开发使用 console，验证码会输出到服务端日志；生产环境必须改为 resend
EMAIL_PROVIDER=console
EMAIL_PRODUCT_NAME=Vega Resume
RESEND_API_KEY=
# 必须使用 Resend 已验证域名，例如：Vega Resume <verify@mail.example.com>
MAIL_FROM=

# PDF 导出（后端 chromedp 打印）
# 打印页所在的前端地址；开发环境要求 vite dev server (make dev-web) 在运行
WEB_BASE_URL=http://localhost:5173
# Chrome 可执行文件路径；留空则自动查找本机安装的 Chrome
CHROME_EXEC_PATH=
# 远程 DevTools 地址（如 ws://localhost:9222），非空时优先于 CHROME_EXEC_PATH
CHROME_REMOTE_URL=
PDF_RENDER_TIMEOUT=30s
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=8
PRINT_TOKEN_TTL=90s
