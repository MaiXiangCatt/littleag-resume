SERVER_ADDR=:8080
DATABASE_URL=postgres://vega_resume:vega_resume@localhost:5432/vega_resume?sslmode=disable
AVATAR_STORAGE_DIR=data/avatars
# Generate a local key with: openssl rand -hex 32
ACCESS_TOKEN_KEY=example_access_token_key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ACCOUNT_LOCK_LIMIT=5
ACCOUNT_LOCK_TTL=15m

# PDF 导出（后端 chromedp 打印）
# 打印页所在的前端地址；开发环境要求 vite dev server (make dev-web) 在运行
WEB_BASE_URL=http://localhost:5173
# Chrome 可执行文件路径；留空则自动查找本机安装的 Chrome
CHROME_EXEC_PATH=
# 远程 DevTools 地址（如 ws://localhost:9222），非空时优先于 CHROME_EXEC_PATH
CHROME_REMOTE_URL=
PDF_RENDER_TIMEOUT=30s
PDF_MAX_CONCURRENCY=2
PRINT_TOKEN_TTL=90s
