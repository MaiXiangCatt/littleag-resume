SERVER_ADDR=:8080
DATABASE_URL=postgres://littleag_resume:littleag_resume@localhost:5432/littleag_resume?sslmode=disable
AVATAR_STORAGE_DIR=data/avatars
TRUSTED_PROXIES=127.0.0.1,::1

# 分别生成两个独立密钥：openssl rand -hex 32
ACCESS_TOKEN_KEY=replace-with-at-least-32-characters
EMAIL_VERIFICATION_KEY=replace-with-another-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
ACCOUNT_LOCK_LIMIT=5
ACCOUNT_LOCK_TTL=15m

# 本地默认把验证码输出到服务端日志；如需联调真实邮件可改为 resend 并配置以下两项。
EMAIL_PROVIDER=console
EMAIL_PRODUCT_NAME=LittleAgResume
RESEND_API_KEY=
MAIL_FROM=LittleAgResume <noreply@mail.littleag.com>
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_ATTEMPT_LIMIT=5
EMAIL_RESEND_COOLDOWN=60s

# 后端通过此地址访问前端打印页。
WEB_BASE_URL=http://localhost:5173
CHROME_EXEC_PATH=
CHROME_REMOTE_URL=
PDF_RENDER_TIMEOUT=30s
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=8
PRINT_TOKEN_TTL=90s
